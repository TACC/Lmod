function build_tStr(epoch, time_offset)
   local myTime = epoch + time_offset
   local lt     = localtime(myTime)
   local year   = lt.tm_year + 1900;
   local month  = lt.tm_mon+1;
   local mday   = lt.tm_mday;
   local hour   = lt.tm_hour;
   local min    = lt.tm_min; 
   local tStr   = string.format("%d-%02d-%02dT%02d:%02d",year, month,mday,
                               hour, min)
   return tStr
end

